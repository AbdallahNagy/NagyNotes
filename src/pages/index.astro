---
import AppLayout from '@/layouts/AppLayout.astro';
import BrowseFolders from '@/components/home/BrowseFolders.astro';
import HomePersonal from '@/components/home/HomePersonal';
import LatestPosts from '@/components/home/LatestPosts.astro';
import { FOLDER_CARD_POST_COUNT, LATEST_POST_COUNT, SITE } from '@/config/site';
import { getContent } from '@/lib/content/load';
import {
  buildPostIndex,
  folderCard,
  getFolder,
  latestPosts,
  newestInFolder,
  toIndexEntry,
} from '@/lib/content/navigation';

const { library } = await getContent();
const index = buildPostIndex(library);
const shelves = library.rootFolderIds.map((id) => ({
  folder: folderCard(library, getFolder(library, id)),
  newest: newestInFolder(library, id, FOLDER_CARD_POST_COUNT),
}));
const latest = latestPosts(library, LATEST_POST_COUNT).map((post) => toIndexEntry(library, post));
---

<AppLayout>
  <div class="home">
    <h1>{SITE.home.heading}</h1>
    <p class="intro">{SITE.home.intro}</p>
    <HomePersonal client:load index={index} />
    <BrowseFolders shelves={shelves} />
    <LatestPosts posts={latest} />
  </div>
</AppLayout>

<style>
  .home {
    box-sizing: content-box;
    max-width: 880px;
    margin-inline: auto;
    padding: 64px clamp(20px, 5vw, 56px) 96px;
  }

  h1 {
    max-width: 18ch;
    font-family: var(--font-serif);
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .intro {
    max-width: 56ch;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
