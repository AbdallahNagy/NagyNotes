<div class="loader" data-loader aria-hidden="true">
  <span class="mark">
    nn<span class="dot">.</span>
  </span>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    background: var(--bg);
    transition:
      opacity var(--motion-fade),
      visibility var(--motion-fade);
    /* Safety net if the script never runs: leave after the 1.1s maximum. */
    animation: loader-timeout var(--motion-fade) 1.1s forwards;
  }

  .loader[data-leaving] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(html[data-loaded]) .loader {
    display: none;
  }

  .mark {
    display: flex;
    align-items: baseline;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 72px;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .dot {
    display: inline-block;
    color: var(--accent);
    animation: bounce 1s ease-in-out infinite;
  }

  @keyframes bounce {
    0%,
    100% {
      opacity: 1;
      transform: translateY(0);
    }
    50% {
      opacity: 0.25;
      transform: translateY(-6px);
    }
  }

  @keyframes loader-timeout {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>

<script>
  import { initLoader } from '@/lib/client/loader';

  initLoader();
</script>
