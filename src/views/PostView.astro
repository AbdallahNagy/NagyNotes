---
import { render } from 'astro:content';
import '@/styles/prose.css';
import AppLayout from '@/layouts/AppLayout.astro';
import Breadcrumb from '@/components/post/Breadcrumb.astro';
import BookmarkButton from '@/components/post/BookmarkButton';
import MobileBottomBar from '@/components/post/MobileBottomBar';
import PrevNext from '@/components/post/PrevNext.astro';
import Toc from '@/components/post/Toc';
import { getContent } from '@/lib/content/load';
import { tocHeadings } from '@/lib/content/headings';
import { getFolder, getPost, postBreadcrumbs, prevNext } from '@/lib/content/navigation';
import { formatDate } from '@/lib/format';

interface Props {
  id: string;
}

const { id } = Astro.props;
const { library, entries } = await getContent();
const post = getPost(library, id);
const entry = entries.get(id);
if (!entry) throw new Error(`Missing content entry for post "${id}"`);

const { Content, headings } = await render(entry);
const toc = tocHeadings(headings);
const crumbs = postBreadcrumbs(library, id);
const { prev, next } = prevNext(library, id);
const folderName = post.folderId === null ? 'Library' : getFolder(library, post.folderId).name;
const step = (target: typeof prev) => (target ? { url: target.url, title: target.title } : null);
---

<AppLayout
  title={post.title}
  description={post.summary}
  type="article"
  publishedTime={post.date.toISOString()}
  hasBottomBar
>
  <div class="layout">
    <article class="article" data-post-id={id} data-pagefind-body>
      <Breadcrumb crumbs={crumbs} />
      <h1 data-pagefind-meta="title">{post.title}</h1>
      <div class="meta" data-pagefind-ignore>
        <span>{post.readTime} min read</span>
        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
        <span class="spacer"></span>
        <BookmarkButton client:load postId={id} />
      </div>
      <div class="prose">
        <Content />
      </div>
      <PrevNext prev={prev} next={next} folderName={folderName} />
    </article>
    {toc.length > 0 && (
      <aside class="toc-column" data-pagefind-ignore>
        <Toc client:load headings={toc} readTime={post.readTime} />
      </aside>
    )}
  </div>
  <MobileBottomBar
    slot="bottom"
    client:load
    prev={step(prev)}
    next={step(next)}
    headings={toc}
    readTime={post.readTime}
  />
</AppLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .article {
    width: 100%;
    min-width: 0;
    max-width: calc(var(--measure) + var(--article-gutter));
    margin: 0 auto;
    padding: 56px 48px 96px;
    font-family: var(--article-font);
    font-size: calc(var(--size-base) - var(--mobile-trim));
    line-height: var(--article-leading);
    color: var(--ink);
  }

  h1 {
    color: var(--ink);
    font-size: 2.05em;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 18px 0 36px;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: normal;
  }

  .spacer {
    flex: 1;
  }

  .toc-column {
    display: none;
  }

  @container main (min-width: 1020px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 220px;
    }

    .toc-column {
      position: sticky;
      top: 0;
      display: block;
      align-self: start;
      padding: 64px 28px 0 0;
    }
  }

  @media (max-width: 759.98px) {
    .article {
      padding: 32px 20px 48px;
    }
  }
</style>
