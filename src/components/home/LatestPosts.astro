---
import { formatDate } from '@/lib/format';
import type { PostIndexEntry } from '@/lib/content/types';

interface Props {
  posts: PostIndexEntry[];
}

const { posts } = Astro.props;
---

<section>
  <h2 class="label">Latest</h2>
  <ul>
    {posts.map((post) => (
      <li>
        <a class="row" href={post.url}>
          <span class="main">
            <span class="title">{post.title}</span>
            <span class="path">{post.folderPath.join(' / ')}</span>
          </span>
          <span class="meta">
            {post.readTime} min · {formatDate(post.date)}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .label {
    margin: 56px 0 4px;
    color: var(--ink-3);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .main {
    display: flex;
    flex: 1 1 320px;
    flex-direction: column;
    gap: 4px;
  }

  .title {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.3;
  }

  .row:hover .title {
    color: var(--accent);
  }

  .path,
  .meta {
    color: var(--ink-3);
    font-size: 13px;
  }

  .meta {
    font-variant-numeric: tabular-nums;
  }
</style>
